{
  "$defs": {
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "pattern": "^CSA-[1-9]00$",
          "title": "Family",
          "type": "string"
        },
        "sub_family": {
          "minLength": 1,
          "title": "Sub Family",
          "type": "string"
        },
        "domains": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        },
        "criticality": {
          "$ref": "#/$defs/Criticality"
        }
      },
      "required": [
        "family",
        "sub_family",
        "domains",
        "criticality"
      ],
      "title": "Classification",
      "type": "object"
    },
    "Criticality": {
      "enum": [
        "CRITICAL",
        "MAJOR",
        "MINOR",
        "INFORMATIVE"
      ],
      "title": "Criticality",
      "type": "string"
    },
    "DocumentStatus": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "VALIDATED",
        "ACTIVE",
        "ACTIVE_WITH_RESERVATIONS",
        "RETIRED"
      ],
      "title": "DocumentStatus",
      "type": "string"
    },
    "Execution": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "pattern": "^CSA-[1-9][0-9]{2}$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        },
        "postconditions": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postconditions"
        }
      },
      "required": [
        "inputs",
        "preconditions",
        "dependencies"
      ],
      "title": "Execution",
      "type": "object"
    },
    "FNCsaDefinition": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "governance": {
          "$ref": "#/$defs/Governance"
        },
        "scientific_description": {
          "$ref": "#/$defs/ScientificDescription"
        },
        "execution": {
          "$ref": "#/$defs/Execution"
        },
        "results": {
          "$ref": "#/$defs/Results"
        },
        "references": {
          "$ref": "#/$defs/References"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          },
          "minItems": 1,
          "title": "History",
          "type": "array"
        }
      },
      "required": [
        "identity",
        "classification",
        "governance",
        "scientific_description",
        "execution",
        "results",
        "references",
        "history"
      ],
      "title": "FNCsaDefinition",
      "type": "object"
    },
    "FailurePrescription": {
      "enum": [
        "NONE",
        "BLOCK_DVS",
        "SUSPEND_VALIDATION",
        "REQUIRE_REVIEW",
        "RECORD_FINDING"
      ],
      "title": "FailurePrescription",
      "type": "string"
    },
    "Governance": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "doctrinal_version": {
          "minLength": 1,
          "title": "Doctrinal Version",
          "type": "string"
        },
        "document_status": {
          "$ref": "#/$defs/DocumentStatus"
        },
        "criticality_level": {
          "$ref": "#/$defs/Criticality"
        },
        "stability_level": {
          "$ref": "#/$defs/StabilityLevel"
        }
      },
      "required": [
        "author",
        "reviewer",
        "authority",
        "doctrinal_version",
        "document_status",
        "criticality_level",
        "stability_level"
      ],
      "title": "Governance",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "nature": {
          "minLength": 1,
          "title": "Nature",
          "type": "string"
        },
        "justification": {
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        }
      },
      "required": [
        "version",
        "date",
        "nature",
        "justification",
        "approved_by"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "csa_id": {
          "pattern": "^CSA-[1-9][0-9]{2}$",
          "title": "Csa Id",
          "type": "string"
        },
        "semantic_code": {
          "pattern": "^[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)+$",
          "title": "Semantic Code",
          "type": "string"
        },
        "official_name": {
          "minLength": 1,
          "title": "Official Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DocumentStatus"
        }
      },
      "required": [
        "csa_id",
        "semantic_code",
        "official_name",
        "version",
        "status"
      ],
      "title": "Identity",
      "type": "object"
    },
    "References": {
      "additionalProperties": false,
      "properties": {
        "doctrinal_documents": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Doctrinal Documents",
          "type": "array"
        },
        "rmcs_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Rmcs Ids",
          "type": "array"
        },
        "esvp_requirements": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Esvp Requirements",
          "type": "array"
        }
      },
      "required": [
        "doctrinal_documents",
        "rmcs_ids",
        "esvp_requirements"
      ],
      "title": "References",
      "type": "object"
    },
    "ResultException": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "code",
        "description"
      ],
      "title": "ResultException",
      "type": "object"
    },
    "ResultState": {
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_APPLICABLE",
        "ERROR"
      ],
      "title": "ResultState",
      "type": "string"
    },
    "Results": {
      "additionalProperties": false,
      "properties": {
        "states": {
          "items": {
            "$ref": "#/$defs/ResultState"
          },
          "minItems": 1,
          "title": "States",
          "type": "array"
        },
        "on_failure": {
          "$ref": "#/$defs/FailurePrescription"
        },
        "justification": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Justification"
        },
        "proofs_used": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proofs Used"
        },
        "rules_applied": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rules Applied"
        },
        "confidence_level": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Level"
        },
        "exceptions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ResultException"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exceptions"
        }
      },
      "required": [
        "states",
        "on_failure"
      ],
      "title": "Results",
      "type": "object"
    },
    "ScientificDescription": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Scope"
        },
        "limits": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Limits"
        },
        "hypotheses": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Hypotheses"
        },
        "exclusions": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Exclusions"
        }
      },
      "required": [
        "objective",
        "scope",
        "limits",
        "hypotheses",
        "exclusions"
      ],
      "title": "ScientificDescription",
      "type": "object"
    },
    "StabilityLevel": {
      "enum": [
        "DRAFT",
        "EXPERIMENTAL",
        "STABLE",
        "DEPRECATED"
      ],
      "title": "StabilityLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Catalog Version",
      "type": "string"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/FNCsaDefinition"
      },
      "minItems": 1,
      "title": "Controls",
      "type": "array"
    }
  },
  "required": [
    "catalog_version",
    "controls"
  ],
  "title": "FN-CSA Catalog Schema",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
