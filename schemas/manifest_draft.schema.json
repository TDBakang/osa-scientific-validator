{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osa-observatory.africa/schemas/rocsa/scaffold-manifest-draft-1.2.0.json",
  "title": "ROCSA Scaffold Manifest Draft 1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "scaffold_contract_version", "generator_version", "template_set_version", "renderer_id", "canonicalization_version", "source", "qualification", "authority", "payload_files", "infrastructure_files", "bundle_fingerprint", "publication_ready"],
  "properties": {
    "manifest_schema_version": {"const": "1.2.0"},
    "scaffold_contract_version": {"$ref": "#/$defs/semver"},
    "generator_version": {"$ref": "#/$defs/semver"},
    "template_set_version": {"$ref": "#/$defs/semver"},
    "renderer_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "canonicalization_version": {"const": "1.0.0"},
    "source": {"$ref": "#/$defs/source"},
    "qualification": {"$ref": "#/$defs/qualification"},
    "authority": {
      "const": {"generated_code": true, "scientifically_validated": false, "publication_authorized": false, "execution_authorized": false}
    },
    "payload_files": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/payload"}},
    "infrastructure_files": {"type": "array", "items": {"$ref": "#/$defs/infrastructure"}},
    "bundle_fingerprint": {"$ref": "#/$defs/sha256"},
    "publication_ready": {"const": false}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "sourceSemver": {
      "type": "string",
      "description": "Version de la fiche source FN-CSA (SemanticVersion de fn_csa.py) : suffixes de pré-version autorisés (ex. 1.0.0-draft). Distinct de #/$defs/semver, réservé aux versions internes de l'outillage — cf. D-SCAFFOLD-21.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "familyId": {
      "type": "string",
      "description": "Identifiant de famille CSA réel par centaine (D-FNCSA-ID-01/02/03). \"CRYPTO\" n'est pas une valeur valide.",
      "pattern": "^CSA-[1-9]00$"
    },
    "documentStatus": {
      "type": "string",
      "description": "Vocabulaire DocumentStatus réel de fn_csa.py (D-SCAFFOLD-21). APPROVED et SUSPENDED n'existent pas.",
      "enum": ["DRAFT", "PROPOSED", "VALIDATED", "ACTIVE", "ACTIVE_WITH_RESERVATIONS", "RETIRED"]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["csa_id", "source_version", "source_fingerprint", "compilation_contract_version"],
      "properties": {
        "csa_id": {"type": "string", "pattern": "^CSA-[1-9][0-9]{2}$"},
        "source_version": {"$ref": "#/$defs/sourceSemver"},
        "source_fingerprint": {"$ref": "#/$defs/sha256"},
        "compilation_contract_version": {"$ref": "#/$defs/semver"}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["source_status", "publication_eligible", "publication_blocking_reasons", "execution_eligible", "execution_blocking_reason"],
      "properties": {
        "source_status": {"$ref": "#/$defs/documentStatus"},
        "publication_eligible": {"type": "boolean"},
        "publication_blocking_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "execution_eligible": {"const": false},
        "execution_blocking_reason": {"type": "string", "minLength": 1}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "role", "sha256", "size_bytes"],
      "properties": {"relative_path": {"type": "string"}, "role": {"enum": ["MODULE", "SCAFFOLD_TEST"]}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}
    },
    "infrastructure": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "role", "required_sha256", "required_size_bytes", "materialization", "ownership"],
      "properties": {"relative_path": {"type": "string"}, "role": {"const": "PACKAGE_MARKER"}, "required_sha256": {"$ref": "#/$defs/sha256"}, "required_size_bytes": {"const": 0}, "materialization": {"const": "REQUIRED"}, "ownership": {"const": "UNRESOLVED"}}
    }
  }
}

